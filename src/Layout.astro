---
import "swiper/css";
import "@styles/styles.scss";
import type { TemplateConfig } from "utils/configType";
import defaultConfig from "utils/config";
import { buildJsonLd } from "utils/seo";

type Seo = TemplateConfig["seo"];

interface Props extends Pick<
  TemplateConfig,
  "backgroundGrid" | "logo" | "ogImage" | "ogImageAlt" | "theme" | "forceTheme" | "name"
> {
  seo: Seo;
  /** Marks the page as no indexable (redirect pages, etc.). */
  noindex?: boolean;
  /** The page includes the FAQ: adds the FAQPage block to the JSON-LD. */
  withFaq?: boolean;
  /** Legal policy, for the BreadcrumbList. */
  breadcrumb?: { name: string };
}

const {
  backgroundGrid,
  seo,
  ogImage,
  ogImageAlt,
  theme,
  forceTheme,
  name,
  noindex = false,
  withFaq = false,
  breadcrumb,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const socialImage = new URL(ogImage, Astro.site ?? Astro.url);

const jsonLd = buildJsonLd({
  config: defaultConfig,
  url: canonical.href,
  faq: withFaq ? defaultConfig.home.faq : undefined,
  breadcrumb: breadcrumb ? [breadcrumb] : undefined,
});

// Analítica opcional sense cookies (GoatCounter). Només s'injecta l'script si
// el config té codi; les insígnies de botiga ja porten `data-goatcounter-click`.
const goatcounterCode = defaultConfig.goatcounterCode;
---

<!doctype html>
<html lang="ca" data-theme={theme}>
  <head>
    <!-- Global Metadata -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- L'app i la web només tenen tema fosc (03-disseny.md). -->
    <meta name="theme-color" content="#101216" />

    <!-- Primary Meta Tags -->
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="ca_ES" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Dades estructurades. No inclou `aggregateRating`: inventar una
         valoració pot ser sancionat per Google. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

    <script is:inline define:vars={{ forceTheme }}>
      // L'HTML surt amb el tema per defecte (dosi-dark). Aquest script només
      // aplica l'elecció explícita de l'usuari, desada a localStorage.
      try {
        const stored = localStorage.getItem("dosi-theme");
        if (stored && !forceTheme) {
          document.documentElement.setAttribute("data-theme", stored);
        }
      } catch (e) {
        // localStorage pot estar bloquejat (mode privat, iframes).
        // En aquest cas es manté el tema per defecte.
      }
    </script>

    {goatcounterCode && (
      <script
        is:inline
        data-goatcounter={`https://${goatcounterCode}.goatcounter.com/count`}
        src="https://gc.zgo.at/count.js"
        async
      />
    )}
  </head>
  <!-- Fons explícit: sense ell el `body` queda transparent i el color depèn
     del que daisyUI apliqui a `html`. -->
  <body class="relative bg-base-100 text-base-content">
    <!-- La quadrícula i el halo del hero són decoració: porten aria-hidden
         perquè el lector de pantalla no els anunciï. -->
    {backgroundGrid && <div class="backgroundGrid" aria-hidden="true" />}
    <div class="hero-glow" aria-hidden="true" />
    <slot />
  </body>
</html>